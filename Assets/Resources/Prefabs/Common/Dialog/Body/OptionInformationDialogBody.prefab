--- !u!114 &114094320201520353
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1099118695303065}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 0.3372549, g: 0.34509805, b: 0.40392157, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: b8f098e1e246b7f4f9a6f13b89693b42, type: 3}
    m_FontSize: 36
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.7
  m_Text: "<color=#EE5F5F>*音声タイミング調整</color>\n楽曲とノーツのタイミングがズレる場合に使用してください。\n楽曲に合わせてノーツを叩くと<color=#FF0000>FASTが多く出る場合（ノーツが楽曲よりも遅く流れてくる場合）は「＋」</color>に、楽曲に合わせてノーツを叩くと<color=#FF0000>SLOWが多く出る場合（ノーツが楽曲よりも早く流れてくる場合）は「－」</color>に調整してください。\n\n<color=#EE5F5F>*判定タイミング調整</color>\n判定ラインに対してノーツを叩く場所を調整したい場合に使用してください。 <color=#FF0000>判定ラインよりも上側で叩きたい場合は「＋」</color>に、<color=#FF0000>判定ラインよりも下側で叩きたい場合は「－」</color>に調整してください。\n※判定ラインの見た目の位置自体は変わりません。"
